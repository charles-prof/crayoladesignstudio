{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "crayola/fluid-gallery",
  "title": "Crayola Fluid Gallery",
  "category": "design",
  "icon": "format-gallery",
  "description": "A fluid, horizontal-scrolling or grid gallery for portfolio items.",
  "attributes": {
    "images": {
      "type": "array",
      "default": []
    },
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "supports": {
    "align": ["full", "wide"]
  },
  "textdomain": "crayola-design",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
