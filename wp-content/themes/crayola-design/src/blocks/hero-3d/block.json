{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "crayola/hero-3d",
  "title": "Crayola 3D Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "A high-end 3D Hero section with GSAP animations.",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Designing Spaces That Breathe."
    },
    "subtitle": {
      "type": "string",
      "default": "Interior • Exterior • ArchViz"
    },
    "imageUrl": {
      "type": "string",
      "default": "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=2000"
    },
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "supports": {
    "align": ["full", "wide"]
  },
  "textdomain": "crayola-design",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
