{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "spacing": {
      "padding": true,
      "margin": true
    },
    "color": {
      "palette": [
        {
          "slug": "background",
          "color": "#F8F8F8",
          "name": "Background"
        },
        {
          "slug": "foreground",
          "color": "#1A1A1A",
          "name": "Foreground"
        },
        {
          "slug": "accent",
          "color": "#8E8A83",
          "name": "Accent"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "system-ui, -apple-system, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        }
      }
    }
  }
}
